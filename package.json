{
  "name": "mcp-filter-proxy",
  "type": "module",
  "version": "0.0.0",
  "description": "MCP proxy that wraps any server to filter exposed tools and bridge across different transports (stdio, SSE, HTTP)",
  "author": "SecretX33 <notyetmidnight@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/SecretX33/mcp-filter-proxy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SecretX33/mcp-filter-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/SecretX33/mcp-filter-proxy/issues"
  },
  "bin": {
    "mcp-filter-proxy": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "proxy"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --env.NODE_ENV=development",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --check --cache src tests .github/scripts",
    "format:write": "prettier --write --cache src tests .github/scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "open": "11.0.4",
    "picomatch": "4.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "prettier": "3.9.10",
    "tsdown": "0.23.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  }
}
